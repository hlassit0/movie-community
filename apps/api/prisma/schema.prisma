generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  name      String
  handle    String      @unique
  avatarUrl String?
  createdAt DateTime    @default(now())
  ratings   Rating[]
  reviews   Review[]
  watchlist Watchlist[]
}

model Movie {
  id            String      @id @default(cuid())
  externalId    String?     @unique
  title         String
  year          Int
  overview      String
  posterUrl     String?
  backdropUrl   String?
  genres        String[]
  runtime       Int?
  director      String?
  cast          String[]    @default([])
  averageRating Float       @default(0)
  ratingCount   Int         @default(0)
  ratings       Rating[]
  reviews       Review[]
  watchlist     Watchlist[]
  createdAt     DateTime    @default(now())
}

model Rating {
  id        String   @id @default(cuid())
  score     Int
  userId    String
  movieId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  @@unique([userId, movieId])
}

model Review {
  id        String   @id @default(cuid())
  body      String
  userId    String
  movieId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  movieId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  @@unique([userId, movieId])
}
