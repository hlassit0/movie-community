{
  "name": "movie-community",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@movie-community/api\" \"npm run dev --workspace=@movie-community/web\"",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@movie-community/api",
    "db:migrate": "npm run db:migrate --workspace=@movie-community/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2"
  }
}
